---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
import { sisterConcerns } from '../data/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: new URL(withBase('/contact-us/'), Astro.site).toString(),
    email: site.publicEmail,
    telephone: site.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.line1,
      addressLocality: site.address.line2,
      addressCountry: 'BD',
    },
  },
];
---

<BaseLayout
  title="Contact us"
  description="Contact Mamun Knitwear Ltd. — Aambag Road, Konabari, Nilnagar, Gazipur, Bangladesh."
  canonicalPath="/contact-us/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Contact us' }]} />
  <PageHeader
    title="Contact us"
    lead="We are always happy to hear from you. Reach to us anytime, any moment."
  />

  <ContactForm />

  <section class="section section--alt">
    <div class="container">
      <div class="heading-block">
        <h2>Our sister concerns</h2>
      </div>
      <ul class="sister-list">
        {
          sisterConcerns.map((concern) => (
            <li class="sister-list__item">
              <h3>{concern.name}</h3>
              {concern.note && <p>{concern.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .section--alt {
    background: var(--color-page-header-bg);
  }

  .sister-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .sister-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .sister-list__item {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .sister-list__item h3 {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-2);
    color: var(--color-primary-dark);
  }

  .sister-list__item p {
    font-size: var(--fs-sm);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Page not found',
  },
];
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noindex
  jsonLd={jsonLd}
>
  <section class="not-found">
    <div class="not-found__glow" aria-hidden="true"></div>
    <div class="container not-found__inner">
      <span class="eyebrow eyebrow--dark">Error</span>
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1>Page not found</h1>
      <p>
        The page you were looking for doesn't exist, may have been moved, or is temporarily
        unavailable.
      </p>
      <div class="not-found__actions">
        <a class="btn btn--primary" href={withBase('/')}>Back to home</a>
        <a class="btn btn--outline-light" href={withBase('/contact-us/')}>Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    padding-block: var(--space-12);
    text-align: center;
    background:
      radial-gradient(60% 120% at 50% 0%, rgb(2 132 199 / 0.22) 0%, transparent 55%),
      var(--color-page-header-bg);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    isolation: isolate;
    overflow: hidden;
  }

  .not-found__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 52ch;
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-size: clamp(5rem, 14vw, 8rem);
    font-weight: var(--fw-bold);
    color: var(--color-accent-bright);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .not-found h1 {
    color: var(--color-white);
    font-size: var(--fs-3xl);
  }

  .not-found p:not(.not-found__code) {
    color: var(--color-page-header-text);
  }

  .not-found__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-3);
  }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import TeamCard from '../components/portfolio/TeamCard.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { aboutText } from '../data/sections';
import { historyMilestones } from '../data/home';
import { certifications } from '../data/logos';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
import Icon from '../components/common/Icon.astro';
import aboutBuilding from '../assets/images/about-building.jpg';

const team = (await getCollection('team')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const profilePdf = site.profilePdf;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${site.name}`,
    url: new URL(withBase('/about-us-2/'), Astro.site).toString(),
    mainEntity: {
      '@type': 'Organization',
      name: site.name,
      description: aboutText.intro[0],
      foundingDate: String(site.established),
    },
  },
];
---

<BaseLayout
  title="About us"
  description={`${site.name} is a 100% export oriented knit garments factory established in ${site.established}, producing best quality knitted items.`}
  canonicalPath="/about-us-2/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'About us' }]} />
  <PageHeader
    title="About us"
    eyebrow="Our story"
    lead="A 100% export oriented knit garments manufacturer in Gazipur, Bangladesh â€” knitting, printing, embroidery and sewing under one roof."
    image={aboutBuilding}
    imageAlt="The Mamun Knitwear Ltd. factory building"
  />

  <section class="section">
    <div class="container about-intro">
      <div class="heading-block">
        <span class="eyebrow">Who we are</span>
        <h2>Who we are</h2>
      </div>
      <div class="prose">
        {aboutText.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="about-intro__actions">
        <a class="btn btn--dark" href={withBase(profilePdf)}>
          <Icon name="download" size={16} />
          Download company profile
        </a>
        <a class="btn btn--outline" href={withBase('/contact-us/')}>
          Get in touch
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        title="Our journey"
        eyebrow="Milestones"
        lead="Key milestones in the history of Mamun Knitwear Ltd."
      />
      <ol class="timeline">
        {
          historyMilestones.map((milestone) => (
            <li class="timeline__item">
              <span class="timeline__year" aria-hidden="true">
                {milestone.year}
              </span>
              <div class="timeline__body">
                <h3>{milestone.title}</h3>
                <p>{milestone.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        title="Our management team"
        eyebrow="Leadership"
        lead="The people who lead Mamun Knitwear Ltd."
      />
      <div class="team-grid">
        {team.map((member) => <TeamCard member={member} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        title="Our certifications"
        eyebrow="Compliance"
        lead="Certifications and memberships we are proud of."
      />
      <ul class="cert-grid">
        {
          certifications.map((cert) => (
            <li class="cert-grid__item">
              <img
                src={cert.image.src}
                alt={cert.alt}
                width={cert.image.width}
                height={cert.image.height}
                loading="lazy"
              />
              <span class="sr-only">{cert.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaSection
    title="Want to know more?"
    text="Get in touch with our team to discuss how we can serve you."
    ctaLabel="Contact us"
    ctaHref="/contact-us/"
  />
</BaseLayout>

<style>
  .about-intro .heading-block {
    margin-bottom: var(--space-5);
  }

  .about-intro__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-8);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--space-5);
    align-items: start;
    position: relative;
  }

  @media (max-width: 639px) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
  }

  .timeline__year {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-white);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    font-family: var(--font-heading);
    font-weight: var(--fw-bold);
    font-size: var(--fs-xl);
    border-radius: var(--radius-md);
    min-height: 72px;
    box-shadow: var(--shadow-sm);
  }

  .timeline__body {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
  }

  .timeline__body h3 {
    margin-bottom: var(--space-2);
    font-size: var(--fs-lg);
  }

  .timeline__body p {
    font-size: var(--fs-sm);
  }

  .team-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cert-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 640px) {
    .cert-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cert-grid__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 104px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition-slow);
  }

  .cert-grid__item:hover {
    border-color: rgb(2 132 199 / 0.35);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .cert-grid__item img {
    max-height: 64px;
    width: auto;
    object-fit: contain;
    transition: transform var(--transition-slow);
  }

  .cert-grid__item:hover img {
    transform: scale(1.12);
  }
</style>

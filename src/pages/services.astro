---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import svcKnitting from '../assets/images/svc-knitting.jpg';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${site.name} services`,
    itemListElement: services.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: service.title,
    })),
  },
];
---

<BaseLayout
  title="Services"
  description="Explore the services of Mamun Knitwear Ltd. — knitting, sample, cutting, sewing, finishing and embroidery."
  canonicalPath="/services/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Services' }]} />
  <PageHeader
    title="Our services"
    lead="Integrated manufacturing facilities for export quality knit garments."
    image={svcKnitting}
    imageAlt="Knitting machines at Mamun Knitwear Ltd."
  />

  <section class="section">
    <div class="container">
      <ul class="services-list">
        {
          services.map((service) => (
            <li class="service-row">
              <a href={service.href} class="service-row__card">
                <div class="service-row__media">
                  <img
                    src={service.image.src}
                    alt={service.imageAlt}
                    width={service.image.width}
                    height={service.image.height}
                    loading="lazy"
                  />
                </div>
                <div class="service-row__body">
                  <h2>{service.title}</h2>
                  <p>{service.summary}</p>
                  <span class="service-row__link">Read more</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaSection
    title="Ready to work with us?"
    text="Contact us to discuss your next order with our manufacturing team."
    ctaLabel="Contact us"
    ctaHref="/contact-us/"
  />
</BaseLayout>

<style>
  .services-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  .service-row__card {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-6);
    align-items: stretch;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .service-row__card:hover,
  .service-row__card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 860px) {
    .service-row__card {
      grid-template-columns: 1fr;
    }
  }

  .service-row__media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media (min-width: 861px) {
    .service-row__media img {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .service-row__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .service-row__body h2 {
    color: var(--color-heading);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: var(--fs-xl);
  }

  .service-row__body p {
    font-size: var(--fs-sm);
    flex: 1;
  }

  .service-row__link {
    color: var(--color-primary);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
  }
</style>

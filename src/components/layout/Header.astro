---
import { site, navigation } from '../../data/site';
import { withBase } from '../../utils/paths';
import Icon from '../common/Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const isNavActive = (item: { href: string; children?: { href: string }[] }) =>
  isActive(item.href) || (item.children?.some((child) => isActive(child.href)) ?? false);
---

<header class="site-header">
  <div class="top-bar">
    <div class="container top-bar__inner">
      <div class="top-bar__contact">
        <a class="top-bar__item" href={`mailto:${site.publicEmail}`}>
          <Icon name="mail" size={14} />
          <span>{site.publicEmail}</span>
        </a>
        <a class="top-bar__item" href={`tel:${site.phoneRaw}`}>
          <Icon name="phone" size={14} />
          <span>{site.phone}</span>
        </a>
      </div>
      <div class="top-bar__right">
        <div class="top-bar__social">
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <Icon name="facebook" size={15} />
          </a>
          <a
            href={site.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <Icon name="linkedin" size={15} />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="header-main">
    <div class="container header-main__inner">
      <a class="brand" href={withBase('/')} aria-label="Mamun Knitwear Ltd. – home">
        <img
          src={withBase('/logo.png')}
          alt="Mamun Knitwear Ltd."
          width="1200"
          height="150"
          class="brand__logo"
        />
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle__input" />
      <label for="nav-toggle" class="nav-toggle" data-nav-toggle>
        <span class="nav-toggle__icon" aria-hidden="true"></span>
        <span class="sr-only" data-nav-toggle-label>Open menu</span>
      </label>

      <nav class="site-nav" aria-label="Main navigation">
        <ul class="site-nav__list">
          {
            navigation.map((item) => (
              <li
                class:list={[
                  'site-nav__item',
                  { 'site-nav__item--has-children': item.children },
                  { 'site-nav__item--active': isNavActive(item) },
                ]}
              >
                <a href={withBase(item.href)} aria-current={isNavActive(item) ? 'page' : undefined}>
                  {item.label}
                  {item.children && <Icon name="chevron" size={14} className="site-nav__caret" />}
                </a>
                {item.children && (
                  <ul class="site-nav__dropdown">
                    {item.children.map((child) => (
                      <li
                        class:list={[
                          'site-nav__dropdown-item',
                          { 'site-nav__dropdown-item--active': isActive(child.href) },
                        ]}
                      >
                        <a
                          href={withBase(child.href)}
                          aria-current={isActive(child.href) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
  }

  .top-bar {
    background: var(--color-footer-bg);
    color: var(--color-footer-muted);
    font-size: var(--fs-xs);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }

  .top-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 40px;
    flex-wrap: wrap;
  }

  .top-bar__contact {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .top-bar__right {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .top-bar__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-footer-text);
    text-decoration: none;
  }

  .top-bar__item:hover,
  .top-bar__item:focus-visible {
    color: var(--color-accent-bright);
  }

  .top-bar__item svg {
    color: var(--color-accent-bright);
  }

  .top-bar__social {
    display: flex;
    gap: var(--space-3);
  }

  .top-bar__social a {
    color: var(--color-footer-text);
    display: inline-flex;
  }

  .top-bar__social a:hover,
  .top-bar__social a:focus-visible {
    color: var(--color-accent-bright);
  }

  .header-main {
    background: rgb(250 250 249 / 0.86);
    backdrop-filter: var(--blur-header);
    -webkit-backdrop-filter: var(--blur-header);
    border-bottom: 1px solid var(--color-border);
    transition: box-shadow var(--transition-slow);
  }

  .header-main__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 84px;
  }

  .brand {
    display: inline-flex;
    flex-shrink: 0;
  }

  .brand__logo {
    width: auto;
    max-height: 46px;
    object-fit: contain;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .site-nav__list {
    display: flex;
    list-style: none;
    gap: clamp(0.4rem, 1.3vw, 1.4rem);
    padding: 0;
    flex-wrap: wrap;
  }

  .site-nav__item a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) 0;
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition:
      color var(--transition),
      border-color var(--transition);
  }

  .site-nav__item a:hover,
  .site-nav__item a:focus-visible {
    color: var(--color-accent);
  }

  .site-nav__item--active a {
    color: var(--color-primary);
    border-bottom-color: var(--color-accent);
  }

  .site-nav__caret {
    margin-left: 2px;
    transition: transform var(--transition);
  }

  .site-nav__item--has-children:hover .site-nav__caret,
  .site-nav__item--has-children:focus-within .site-nav__caret {
    transform: rotate(180deg);
  }

  /* Dropdown (desktop) */
  .site-nav__item--has-children {
    position: relative;
  }

  .site-nav__dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: var(--z-header);
    min-width: 220px;
    list-style: none;
    padding: var(--space-2);
    margin: 0;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .site-nav__item--has-children:hover .site-nav__dropdown,
  .site-nav__item--has-children:focus-within .site-nav__dropdown {
    display: block;
  }

  .site-nav__dropdown-item a {
    display: block;
    width: 100%;
    min-height: 0;
    padding: var(--space-3) var(--space-4);
    border-bottom: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    color: var(--color-text);
  }

  .site-nav__dropdown-item a:hover,
  .site-nav__dropdown-item a:focus-visible {
    background: var(--color-primary-soft);
    color: var(--color-accent);
  }

  .site-nav__dropdown-item--active a {
    color: var(--color-accent);
    font-weight: var(--fw-semibold);
    background: var(--color-accent-soft);
  }

  /* Mobile toggle (checkbox hack: works without JS) */
  .nav-toggle__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .nav-toggle {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1023px) {
    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-white);
      cursor: pointer;
    }

    .nav-toggle__icon {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--color-ink);
      position: relative;
    }

    .nav-toggle__icon::before,
    .nav-toggle__icon::after {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--color-ink);
    }

    .nav-toggle__icon::before {
      top: -7px;
    }

    .nav-toggle__icon::after {
      top: 7px;
    }

    .nav-toggle__input:checked ~ .nav-toggle .nav-toggle__icon {
      background: transparent;
    }

    .nav-toggle__input:checked ~ .nav-toggle .nav-toggle__icon::before {
      top: 0;
      transform: rotate(45deg);
    }

    .nav-toggle__input:checked ~ .nav-toggle .nav-toggle__icon::after {
      top: 0;
      transform: rotate(-45deg);
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-3) var(--container-pad) var(--space-5);
      background: var(--color-white);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-lg);
      display: none;
    }

    .nav-toggle__input:checked ~ .site-nav {
      display: flex;
    }

    .site-nav__list {
      flex-direction: column;
      gap: 0;
    }

    .site-nav__item a {
      width: 100%;
      border-bottom: 1px solid var(--color-border);
    }

    .site-nav__item--active a {
      border-bottom-color: var(--color-border);
    }

    .site-nav__item--has-children:hover .site-nav__dropdown,
    .site-nav__item--has-children:focus-within .site-nav__dropdown {
      display: block;
    }

    .site-nav__dropdown {
      position: static;
      display: block;
      min-width: 0;
      width: 100%;
      background: var(--color-primary-soft);
      border: none;
      border-radius: 0;
      box-shadow: none;
      padding: var(--space-2) var(--space-2) var(--space-3);
      margin: 0 0 var(--space-1);
    }

    .site-nav__dropdown-item a {
      padding: var(--space-2) var(--space-4);
      color: var(--color-muted);
    }

    .site-nav__dropdown-item--active a {
      color: var(--color-accent);
      background: transparent;
    }
  }

  @media (min-width: 1024px) {
    .nav-toggle__input,
    .nav-toggle {
      display: none;
    }
  }
</style>

<script>
  // Progressive enhancement: keep aria-expanded/aria-label in sync with the
  // native checkbox state. Core menu behaviour works without this script.
  const toggle = document.querySelector('[data-nav-toggle]');
  const input = document.querySelector<HTMLInputElement>('#nav-toggle');
  const label = document.querySelector<HTMLElement>('[data-nav-toggle-label]');
  if (toggle && input && label) {
    input.addEventListener('change', () => {
      const open = input.checked;
      label.textContent = open ? 'Close menu' : 'Open menu';
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>

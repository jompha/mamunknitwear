---
import { withBase } from '../../utils/paths';
import Icon from '../common/Icon.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li>
      <a href={withBase('/')}><Icon name="home" size={14} /> <span class="sr-only">Home</span></a>
    </li>
    {
      items.map((crumb) => (
        <li>
          {crumb.href ? (
            <a href={withBase(crumb.href)}>{crumb.label}</a>
          ) : (
            <span aria-current="page">{crumb.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-size: var(--fs-sm);
    padding-block: var(--space-3);
  }

  .breadcrumbs a:hover,
  .breadcrumbs a:focus-visible {
    color: var(--color-accent);
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--color-accent);
    font-weight: var(--fw-semibold);
  }

  .breadcrumbs ol {
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    color: var(--color-muted);
  }

  .breadcrumbs a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-muted);
    text-decoration: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

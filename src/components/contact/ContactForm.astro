---
import { site } from '../../data/site';

const endpoint = site.contactFormEndpoint;
const mailto = `mailto:${site.publicEmail}`;
---

<section class="contact-form-section section">
  <div class="container">
    <div class="heading-block">
      <span class="eyebrow">Send a message</span>
      <h2>Send us a message</h2>
      <p class="heading-block__lead">
        Fill in the form and our team will get back to you as soon as possible.
      </p>
    </div>
    <div class="contact-form-wrap">
      <form
        class="contact-form"
        action={endpoint || mailto}
        method="post"
        data-contact-form
        data-testid="contact-form"
        data-mailto={mailto}
        {...endpoint ? {} : { enctype: 'text/plain', target: '_blank' }}
      >
        <div class="contact-form__grid">
          <div class="contact-form__fields">
            <div class="form-group">
              <label for="contact-name">Your Name <span aria-hidden="true">(required)</span></label>
              <input id="contact-name" name="your-name" type="text" required autocomplete="name" />
            </div>
            <div class="form-group">
              <label for="contact-email"
                >Your Email <span aria-hidden="true">(required)</span></label
              >
              <input
                id="contact-email"
                name="your-email"
                type="email"
                required
                autocomplete="email"
              />
            </div>
            <div class="form-group">
              <label for="contact-subject">Subject</label>
              <input id="contact-subject" name="your-subject" type="text" autocomplete="off" />
            </div>
          </div>
          <div class="contact-form__message">
            <div class="form-group">
              <label for="contact-message">Your Message</label>
              <textarea id="contact-message" name="your-message" rows="4" required></textarea>
            </div>
            <button class="btn btn--primary" type="submit">Send Message</button>
          </div>
        </div>

        <!-- Honeypot: hidden from humans, traps naive bots. -->
        <div class="form-group form-group--hp" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {endpoint && <p class="form-status" data-form-status role="status" aria-live="polite" />}
      </form>

      <p class="contact-form__fallback">
        Having trouble with the form? Email us directly at{' '}
        <a href={mailto}>{site.publicEmail}</a>.
      </p>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement for the static contact form.
  // - No endpoint configured: build a mailto: link from the submitted values
  //   (works even though GitHub Pages cannot process POST requests).
  // - Endpoint configured: POST as JSON to the configured form service.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const endpoint = form?.getAttribute('action') ?? '';
  const fallbackMailto = form?.getAttribute('data-mailto') ?? '';
  const usesEndpoint = endpoint.startsWith('http');
  const email = {
    name: 'your-name',
    mail: 'your-email',
    subject: 'your-subject',
    message: 'your-message',
  };

  form?.addEventListener('submit', (event) => {
    const name = form.querySelector<HTMLInputElement>(`[name="${email.name}"]`)?.value ?? '';
    const mail = form.querySelector<HTMLInputElement>(`[name="${email.mail}"]`)?.value ?? '';
    const subject = form.querySelector<HTMLInputElement>(`[name="${email.subject}"]`)?.value ?? '';
    const message =
      form.querySelector<HTMLTextAreaElement>(`[name="${email.message}"]`)?.value ?? '';
    const hp = form.querySelector<HTMLInputElement>('[name="website"]')?.value ?? '';

    if (hp) {
      // Likely a bot; swallow the submission silently.
      event.preventDefault();
      return;
    }

    if (!usesEndpoint) {
      event.preventDefault();
      const body = `Name: ${name}\nEmail: ${mail}\n\nMessage:\n${message}`;
      const link = `${fallbackMailto}?subject=${encodeURIComponent(subject || 'Message from the website')}&body=${encodeURIComponent(body)}`;
      window.location.href = link;
      return;
    }

    event.preventDefault();
    if (status) status.textContent = 'Sending…';
    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, email: mail, subject, message }),
    })
      .then((res) => {
        if (res.ok && status) {
          status.textContent = 'Thank you — your message has been sent.';
          form.reset();
        } else if (status) {
          status.textContent = 'Sorry, sending failed. Please email us directly instead.';
        }
      })
      .catch(() => {
        if (status) status.textContent = 'Sorry, sending failed. Please email us directly instead.';
      });
  });
</script>

<style>
  .contact-form-wrap {
    max-width: 860px;
    margin-inline: auto;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    box-shadow: var(--shadow-sm);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-form__grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .contact-form__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .contact-form__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-form__message {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-form__message textarea {
    flex: 1;
    min-height: 110px;
    resize: vertical;
  }

  .form-group label {
    display: block;
    margin-bottom: var(--space-1);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
    font-size: var(--fs-sm);
  }

  .form-group label span {
    color: var(--color-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-normal);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-background);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-muted);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgb(2 132 199 / 0.18);
    background: var(--color-white);
  }

  .form-group--hp {
    position: absolute;
    left: -9999px;
    top: -9999px;
    height: 0;
    overflow: hidden;
  }

  .form-status {
    font-size: var(--fs-sm);
    color: var(--color-accent-dark);
  }

  .contact-form__fallback {
    margin-top: var(--space-4);
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }
</style>

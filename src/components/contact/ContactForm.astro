---
import { site } from '../../data/site';
import Icon from '../common/Icon.astro';

const endpoint = site.contactFormEndpoint;
const mailto = `mailto:${site.publicEmail}`;
---

<section class="contact-form-section section">
  <div class="container">
    <div class="contact-form-section__grid">
      <div class="contact-info-box">
        <span class="eyebrow">Contact information</span>
        <h2>Do Contact Us</h2>
        <p>
          We are always happy and eager to hear from you. Reach to us anytime, any moment — we would
          love to have some conversation and build a great relationship ahead.
        </p>
        <address class="contact-info-box__list">
          <p>
            <span class="contact-info-box__icon"><Icon name="map-pin" size={16} /></span>
            <span>{site.name}<br />{site.address.line1}, {site.address.line2}, Bangladesh</span>
          </p>
          <p>
            <span class="contact-info-box__icon"><Icon name="phone" size={16} /></span>
            <span
              ><a href={`tel:${site.phoneRaw}`}>{site.phone}</a><br /><a
                href={`tel:${site.phoneAltRaw}`}>{site.phoneAlt}</a
              ></span
            >
          </p>
          <p>
            <span class="contact-info-box__icon"><Icon name="clock" size={16} /></span>
            <span>Fax: {site.fax}</span>
          </p>
          <p>
            <span class="contact-info-box__icon"><Icon name="mail" size={16} /></span>
            <span><a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a></span>
          </p>
          <p>
            <span class="contact-info-box__icon"><Icon name="globe" size={16} /></span>
            <span
              ><a href={site.website} target="_blank" rel="noopener noreferrer"
                >{site.website.replace('https://', '')}</a
              ></span
            >
          </p>
        </address>
      </div>

      <div class="contact-form-wrap">
        <form
          class="contact-form"
          action={endpoint || mailto}
          method="post"
          data-contact-form
          data-testid="contact-form"
          data-mailto={mailto}
          {...endpoint ? {} : { enctype: 'text/plain', target: '_blank' }}
        >
          <div class="form-group">
            <label for="contact-name">Your Name <span aria-hidden="true">(required)</span></label>
            <input id="contact-name" name="your-name" type="text" required autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="contact-email">Your Email <span aria-hidden="true">(required)</span></label>
            <input
              id="contact-email"
              name="your-email"
              type="email"
              required
              autocomplete="email"
            />
          </div>
          <div class="form-group">
            <label for="contact-subject">Subject</label>
            <input id="contact-subject" name="your-subject" type="text" autocomplete="off" />
          </div>
          <div class="form-group">
            <label for="contact-message">Your Message</label>
            <textarea id="contact-message" name="your-message" rows="6" required></textarea>
          </div>

          <!-- Honeypot: hidden from humans, traps naive bots. -->
          <div class="form-group form-group--hp" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input
              id="contact-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          {endpoint && <p class="form-status" data-form-status role="status" aria-live="polite" />}
          <button class="btn btn--primary" type="submit">Send Message</button>
        </form>

        <p class="contact-form__fallback">
          Having trouble with the form? Email us directly at{' '}
          <a href={mailto}>{site.publicEmail}</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement for the static contact form.
  // - No endpoint configured: build a mailto: link from the submitted values
  //   (works even though GitHub Pages cannot process POST requests).
  // - Endpoint configured: POST as JSON to the configured form service.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const endpoint = form?.getAttribute('action') ?? '';
  const fallbackMailto = form?.getAttribute('data-mailto') ?? '';
  const usesEndpoint = endpoint.startsWith('http');
  const email = {
    name: 'your-name',
    mail: 'your-email',
    subject: 'your-subject',
    message: 'your-message',
  };

  form?.addEventListener('submit', (event) => {
    const name = form.querySelector<HTMLInputElement>(`[name="${email.name}"]`)?.value ?? '';
    const mail = form.querySelector<HTMLInputElement>(`[name="${email.mail}"]`)?.value ?? '';
    const subject = form.querySelector<HTMLInputElement>(`[name="${email.subject}"]`)?.value ?? '';
    const message =
      form.querySelector<HTMLTextAreaElement>(`[name="${email.message}"]`)?.value ?? '';
    const hp = form.querySelector<HTMLInputElement>('[name="website"]')?.value ?? '';

    if (hp) {
      // Likely a bot; swallow the submission silently.
      event.preventDefault();
      return;
    }

    if (!usesEndpoint) {
      event.preventDefault();
      const body = `Name: ${name}\nEmail: ${mail}\n\nMessage:\n${message}`;
      const link = `${fallbackMailto}?subject=${encodeURIComponent(subject || 'Message from the website')}&body=${encodeURIComponent(body)}`;
      window.location.href = link;
      return;
    }

    event.preventDefault();
    if (status) status.textContent = 'Sending…';
    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, email: mail, subject, message }),
    })
      .then((res) => {
        if (res.ok && status) {
          status.textContent = 'Thank you — your message has been sent.';
          form.reset();
        } else if (status) {
          status.textContent = 'Sorry, sending failed. Please email us directly instead.';
        }
      })
      .catch(() => {
        if (status) status.textContent = 'Sorry, sending failed. Please email us directly instead.';
      });
  });
</script>

<style>
  .contact-form-section__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .contact-form-section__grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }

  .contact-info-box h2 {
    margin-bottom: var(--space-4);
    color: var(--color-white);
  }

  .contact-info-box > p {
    margin-bottom: var(--space-5);
    color: var(--color-page-header-text);
  }

  .contact-info-box {
    background:
      radial-gradient(60% 100% at 100% 0%, rgb(161 98 7 / 0.22) 0%, transparent 60%),
      var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-7);
  }

  .contact-info-box__list {
    font-style: normal;
    margin-top: var(--space-5);
  }

  .contact-info-box__list p {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: var(--fs-sm);
    max-width: none;
    color: var(--color-footer-text);
  }

  .contact-info-box__list p:last-child {
    margin-bottom: 0;
  }

  .contact-info-box__list a {
    color: var(--color-footer-text);
  }

  .contact-info-box__list a:hover,
  .contact-info-box__list a:focus-visible {
    color: var(--color-accent-bright);
  }

  .contact-info-box__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.08);
    color: var(--color-accent-bright);
    border: 1px solid rgb(255 255 255 / 0.12);
  }

  .contact-form-wrap {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    box-shadow: var(--shadow-sm);
  }

  .contact-form {
    display: grid;
    gap: var(--space-5);
  }

  .form-group label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
    font-size: var(--fs-sm);
  }

  .form-group label span {
    color: var(--color-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-normal);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-background);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-muted);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgb(161 98 7 / 0.18);
    background: var(--color-white);
  }

  .form-group--hp {
    position: absolute;
    left: -9999px;
    top: -9999px;
    height: 0;
    overflow: hidden;
  }

  .form-status {
    font-size: var(--fs-sm);
    color: var(--color-accent-dark);
  }

  .contact-form__fallback {
    margin-top: var(--space-5);
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }
</style>

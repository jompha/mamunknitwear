---
import type { LogoItem } from '../../data/logos';
import SectionHeading from './SectionHeading.astro';

interface Props {
  title: string;
  items: LogoItem[];
  lead?: string;
  eyebrow?: string;
}

const { title, items, lead, eyebrow } = Astro.props;
---

<section class="logo-strip section section--alt">
  <div class="container">
    <SectionHeading title={title} lead={lead} eyebrow={eyebrow} />
    <ul class="logo-strip__list">
      {
        items.map((item) => (
          <li class="logo-strip__item">
            <img
              src={item.image.src}
              alt={item.alt}
              width={item.image.width}
              height={item.image.height}
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .logo-strip__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 640px) {
    .logo-strip__list {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .logo-strip__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 84px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition-slow);
  }

  .logo-strip__item:hover {
    border-color: rgb(2 132 199 / 0.35);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .logo-strip__item img {
    max-height: 48px;
    width: auto;
    object-fit: contain;
    transition: transform var(--transition-slow);
  }

  .logo-strip__item:hover img {
    transform: scale(1.12);
  }
</style>

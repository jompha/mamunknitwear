---
import { withBase } from '../../utils/paths';

interface Props {
  title: string;
  text: string;
  ctaLabel: string;
  ctaHref: string;
}

const { title, text, ctaLabel, ctaHref } = Astro.props;
---

<section class="cta section">
  <div class="container cta__inner">
    <h2>{title}</h2>
    <p>{text}</p>
    <a class="btn btn--light" href={withBase(ctaHref)}>{ctaLabel}</a>
  </div>
</section>

<style>
  .cta {
    background:
      linear-gradient(rgb(52 152 219 / 0.92), rgb(52 152 219 / 0.92)), var(--color-primary);
    color: var(--color-white);
    text-align: center;
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .cta h2 {
    color: var(--color-white);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .cta p {
    max-width: 60ch;
    color: rgb(255 255 255 / 0.95);
  }
</style>

---
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, lead, eyebrow, image, imageAlt = '' } = Astro.props;
---

<section class="page-header">
  <div class="page-header__glow" aria-hidden="true"></div>
  <div class="container">
    {
      image ? (
        <div class="page-header__grid">
          <div class="page-header__copy">
            {eyebrow && <span class="eyebrow eyebrow--dark">{eyebrow}</span>}
            <h1>{title}</h1>
            {lead && <p class="page-header__lead">{lead}</p>}
          </div>
          <div class="page-header__media">
            <img class="page-header__img" src={image.src} alt={imageAlt} loading="lazy" />
          </div>
        </div>
      ) : (
        <>
          {eyebrow && <span class="eyebrow eyebrow--dark">{eyebrow}</span>}
          <h1>{title}</h1>
          {lead && <p class="page-header__lead">{lead}</p>}
        </>
      )
    }
  </div>
</section>

<style>
  .page-header {
    position: relative;
    background:
      radial-gradient(60% 120% at 80% -10%, rgb(2 132 199 / 0.25) 0%, transparent 55%),
      var(--color-page-header-bg);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    padding-block: var(--space-10);
    isolation: isolate;
    overflow: hidden;
  }

  .page-header__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .page-header h1 {
    color: var(--color-white);
    font-size: var(--fs-display);
    font-weight: var(--fw-bold);
    letter-spacing: -0.02em;
    position: relative;
    display: inline-block;
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .page-header h1::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 64px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-bright));
  }

  .page-header__lead {
    margin-top: var(--space-3);
    max-width: 60ch;
    color: var(--color-page-header-text);
  }

  .page-header__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 900px) {
    .page-header__grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .page-header__media {
    min-width: 0;
  }

  .page-header__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 639px) {
    .page-header h1 {
      font-size: var(--fs-3xl);
    }
  }
</style>

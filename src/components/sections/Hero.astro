---
import type { ImageMetadata } from 'astro';
import { withBase } from '../../utils/paths';

interface Props {
  title: string;
  text: string;
  ctaLabel: string;
  ctaHref: string;
  image: ImageMetadata;
  imageAlt?: string;
}

const { title, text, ctaLabel, ctaHref, image, imageAlt = '' } = Astro.props;
---

<section class="hero">
  <div class="hero__media">
    <picture>
      <source srcset={image.src} />
      <img
        src={image.src}
        alt={imageAlt}
        width={image.width}
        height={image.height}
        fetchpriority="high"
      />
    </picture>
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>
  <div class="container hero__content">
    <h1 class="hero__title">{title}</h1>
    <p class="hero__text">{text}</p>
    <a class="btn btn--primary" href={withBase(ctaHref)}>{ctaLabel}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(70vh, 560px);
    color: var(--color-white);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media img,
  .hero__media picture {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(0 0 0 / 0.72) 0%,
      rgb(0 0 0 / 0.45) 55%,
      rgb(0 0 0 / 0.2) 100%
    );
  }

  .hero__content {
    padding-block: var(--space-12);
  }

  .hero__title {
    color: var(--color-white);
    font-size: clamp(1.75rem, 4.5vw, 3rem);
    font-weight: var(--fw-bold);
    max-width: 16ch;
    margin-bottom: var(--space-5);
  }

  .hero__text {
    color: rgb(255 255 255 / 0.92);
    font-size: var(--fs-lg);
    max-width: 52ch;
    margin-bottom: var(--space-6);
  }
</style>
